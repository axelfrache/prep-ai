# Copy this file to .env and fill in your values.

# Google Gemini API key (required for generation).
GEMINI_API_KEY=

# Gemini model to use (optional).
GEMINI_MODEL=gemini-3.6-flash

# Host port the web app is exposed on (optional, defaults to 8080).
WEB_PORT=8080

# Comma-separated allowed CORS origins for the backend (optional).
ALLOWED_ORIGINS=http://localhost:8080
