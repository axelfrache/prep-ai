# Copy this file to .env and fill in your values.

# ai-gateway URL and API key (required for generation).
# https://github.com/axelfrache/ai-gateway
AI_GATEWAY_URL=http://ai-gateway.ai.svc.cluster.local:8080
AI_GATEWAY_API_KEY=

# Models to use (optional), as "provider:model" strings or ai-gateway aliases.
# Default uses the ai-gateway:json alias (gateway-side JSON fallback chain).
# Advanced is used when the UI option is enabled.
AI_GATEWAY_DEFAULT_MODEL=ai-gateway:json
AI_GATEWAY_ADVANCED_MODEL=gemini:gemini-3.6-flash

# Optional second model tried if AI_GATEWAY_ADVANCED_MODEL is rate-limited/unavailable.
# Empty by default (advanced stays pinned to a single model, no fallback).
AI_GATEWAY_ADVANCED_FALLBACK_MODEL=

# JWT signing secret (required). Use a long random string in production.
JWT_SECRET=change-me-with-a-long-random-secret
JWT_TTL=24h

# Postgres credentials (optional, sensible defaults).
POSTGRES_USER=prepai
POSTGRES_PASSWORD=prepai
POSTGRES_DB=prepai

# Host port the web app is exposed on (optional, defaults to 8080).
WEB_PORT=8080

# Comma-separated allowed CORS origins for the backend (optional).
ALLOWED_ORIGINS=http://localhost:8080
